<Window x:Class="WpfApp1.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sinh viên Khoa CNTT (MaKhoa = 1)" Height="420" Width="700"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="Bold" FontSize="13" Text="Danh sách sinh viên – Khoa CNTT (MaKhoa = 1)"/>

        <DataGrid x:Name="dgDanhSach2" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F0F9F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSv}" Width="70"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*"/>
                <DataGridTextColumn Header="Số Lần XS" Binding="{Binding SoLanXs}" Width="90"/>
                <DataGridTextColumn Header="Tiền Thưởng" Binding="{Binding TienThuong, StringFormat='{}{0:N0} đ'}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>